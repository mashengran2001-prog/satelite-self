{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satelite",
  "version": "../package.json",
  "identifier": "com.satelite.proxy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Satelite",
        "width": 960,
        "height": 720,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/darwin-arm64/sing-box",
      "resources/bin/darwin-arm64/version.txt",
      "resources/bin/darwin-arm64/xray",
      "resources/bin/darwin-arm64/xray-version.txt",
      "resources/bin/darwin-arm64/geosite.dat",
      "resources/bin/darwin-arm64/geoip.dat",
      "resources/bin/darwin-arm64/mihomo",
      "resources/bin/darwin-arm64/mihomo-version.txt",
      "resources/bin/darwin-arm64/mihomo-geodata/Country.mmdb",
      "resources/bin/darwin-arm64/mihomo-geodata/geosite.dat",
      "resources/rule-sets",
      "resources/dns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["clash", "sing-box", "singbox"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBMkIzRkM5RThBRkRGRjcKUldUMzM2L295VDhyYXZ1emVxR2FKNWp3S0htMTNNNlZsTlZ2RkdLTUpsOTdhb2ljSEIwMy9nV1IK",
      "endpoints": [
        "https://github.com/mashengran2001-prog/satelite-self/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
